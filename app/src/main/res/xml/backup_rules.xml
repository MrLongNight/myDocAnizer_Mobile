<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- System-Backup schützt Einstellungen, aber schließt sensible Klartext-Dokumente und Passwörter strikt aus -->
    <exclude domain="file" path="Documents" />
    <exclude domain="file" path="Scans" />
    <exclude domain="file" path="Backups" />
    <exclude domain="file" path="Models" />
    <exclude domain="file" path="Temp" />
    <exclude domain="file" path="tmp" />
    <exclude domain="external" path="." />
    <exclude domain="database" path="mydocanizer_database" />
    <exclude domain="database" path="mydocanizer_database-shm" />
    <exclude domain="database" path="mydocanizer_database-wal" />
    <exclude domain="sharedpref" path="mydocanizer_prefs.xml" />
    <exclude domain="sharedpref" path="mydocanizer_vault_security.xml" />
    <exclude domain="sharedpref" path="doc_rules_storage.xml" />
</full-backup-content>
