<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Dokumente und lokale SQLite-Datenbank verlassen niemals unverschlüsselt das Gerät -->
        <exclude domain="file" path="Documents" />
        <exclude domain="file" path="Scans" />
        <exclude domain="file" path="Backups" />
        <exclude domain="file" path="Models" />
        <exclude domain="file" path="Temp" />
        <exclude domain="file" path="tmp" />
        <exclude domain="external" path="." />
        <exclude domain="database" path="mydocanizer_database" />
        <exclude domain="database" path="mydocanizer_database-shm" />
        <exclude domain="database" path="mydocanizer_database-wal" />
        <exclude domain="sharedpref" path="mydocanizer_prefs.xml" />
        <exclude domain="sharedpref" path="mydocanizer_vault_security.xml" />
        <exclude domain="sharedpref" path="doc_rules_storage.xml" />
        <exclude domain="sharedpref" path="mydocanizer_auth_backoff.xml" />
    </cloud-backup>
    <device-transfer>
        <!--
            Fail-closed: Keine pauschale Übertragung aller Dateien/Datenbanken.
            Dokumentordner können je nach Nutzereinstellung auch Klartext enthalten;
            die Room-Datenbank enthält Metadaten/OCR-Text. Ein Gerätewechsel muss
            über den ausdrücklich gestarteten, verschlüsselten Export/Restore erfolgen.
        -->
        <exclude domain="file" path="Documents" />
        <exclude domain="file" path="Scans" />
        <exclude domain="file" path="Backups" />
        <exclude domain="file" path="Models" />
        <exclude domain="file" path="Temp" />
        <exclude domain="file" path="tmp" />
        <exclude domain="external" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="mydocanizer_vault_security.xml" />
        <exclude domain="sharedpref" path="mydocanizer_prefs.xml" />
        <exclude domain="sharedpref" path="doc_rules_storage.xml" />
        <exclude domain="sharedpref" path="mydocanizer_auth_backoff.xml" />
    </device-transfer>
</data-extraction-rules>
